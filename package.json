{
  "name": "mind-emotions-family",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "predeploy": "npm run build",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"tests/**/*.js\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"tests/**/*.js\" \"*.json\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "^0.468.0",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
